generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HOGAR
  RECOLECTOR
  CENTRO_ACOPIO
  EMPRESA_B2B
  ADMIN
  TIENDA
}

enum UserStatus {
  PENDING_EMAIL_VERIFICATION
  ACTIVE
  LOCKED_PIN_ATTEMPTS
  SUSPENDED_DEBT
  SUSPENDED_FRAUD
  DELETION_REQUESTED
  DELETED_ARCO
}

model User {
  id                  String     @id @db.Uuid
  email               String     @unique
  role                Role
  userStatus          UserStatus @default(ACTIVE)
  profilePhotoUrl     String?
  walletAddress       String?    @unique
  encryptedPrivateKey String?
  encryptionIv        String?
  encryptionTag       String?
  receptionPin        String?
  fcmToken            String?
  isActive            Boolean    @default(true)
  deletedAt           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  name                String?
  phone               String?
  address             String?
  latitude            Float?
  longitude           Float?
  marketingAccepted   Boolean    @default(false)
  reputationScore     Float      @default(5.0)
  totalRatings        Int        @default(0)
  requiresQaReview    Boolean    @default(false)

  householdRequests      CollectionRequest[] @relation("HouseholdRequests")
  collectorRequests      CollectionRequest[] @relation("CollectorRequests")
  assignedCenterRequests CollectionRequest[] @relation("AssignedCenterRequests")
  collectorBatches       Batch[]             @relation("CollectorBatches")
  destinationBatches     Batch[]             @relation("DestinationBatches")
  notifications          Notification[]
  centerConsolidations   ConsolidatedBatch[] @relation("CenterConsolidations")
  kycApplications        KycApplication[]
  buyerSales             Sale[]              @relation("BuyerSales")
  centerSales            Sale[]              @relation("CenterSales")
  certificates           Certificate[]
  inventoryItems         InventoryItem[]
  inventoryMovements     InventoryMovement[]
  complaints             Complaint[]
  buyerTransfers         B2bTransfer[]       @relation("BuyerTransfers")
  centerTransfers        B2bTransfer[]       @relation("CenterTransfers")
  disputesOpened         DisputeCase[]       @relation("UserDisputes")

  storeProfile        StoreProfile?
  redemptions         RedemptionTransaction[] @relation("HouseholdRedemptions")
  consentAudits       ConsentAudit[]
  priceLists          AcopioPriceList[]
  bids                AcopioBid[]
  paymentTransactions PaymentTransaction[]
  deviceTokens        DeviceToken[]
  accounts            Account[]

  @@map("users")
}

enum AssignmentMode {
  AUTOMATIC
  AUCTION
}

enum RequestStatus {
  PENDING
  AUCTION_ACTIVE
  AUCTION_ASSIGNED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  COMPLETED
  CANCELLED
  UNATTENDED
  REJECTED_ON_SITE
}

model CollectionRequest {
  id                 String         @id @default(uuid()) @db.Uuid
  status             RequestStatus  @default(PENDING)
  assignmentMode     AssignmentMode @default(AUTOMATIC)
  itemsEstimated     Json
  actualWeights      Json?
  photoUrl           String?
  description        String?
  verificationPin    String
  latitude           Float
  longitude          Float
  householdId        String         @db.Uuid
  collectorId        String?        @db.Uuid
  assignedCenterId   String?        @db.Uuid
  agreedRates        Json?
  escrowLocked       Decimal        @default(0) @db.Decimal(14, 4)
  batchId            String?        @db.Uuid
  rating             Int?
  feedback           String?
  enRouteAt          DateTime?
  arrivedAt          DateTime?
  cancellationFeePen Decimal?       @db.Decimal(12, 2)
  noShowFeePen       Decimal?       @db.Decimal(12, 2)
  rejectionReason    String?
  rejectionPhotos    Json?
  auctionExpiresAt   DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  household      User        @relation("HouseholdRequests", fields: [householdId], references: [id])
  collector      User?       @relation("CollectorRequests", fields: [collectorId], references: [id])
  assignedCenter User?       @relation("AssignedCenterRequests", fields: [assignedCenterId], references: [id])
  batch          Batch?      @relation(fields: [batchId], references: [id])
  bids           AcopioBid[]

  @@index([status, assignedCenterId])
  @@index([batchId])
  @@index([collectorId])
  @@index([householdId])
  @@map("collection_requests")
}

enum BatchStatus {
  OPEN
  IN_TRANSIT
  PROCESSING
  PARTIALLY_ACCEPTED
  RECEIVED
  CONSOLIDATED
  FLAGGED_FOR_REVIEW
  DISPUTED
  REROUTED
}

model Batch {
  id                  String      @id @default(uuid()) @db.Uuid
  status              BatchStatus @default(OPEN)
  collectorId         String      @db.Uuid
  destinationCenterId String?     @db.Uuid
  materialsActual     Json?
  usefulWeightKg      Decimal?    @db.Decimal(14, 3)
  wasteWeightKg       Decimal?    @db.Decimal(14, 3)
  previousCenterId    String?     @db.Uuid
  rerouteReason       String?
  consolidatedBatchId String?     @db.Uuid
  ipfsCid             String?
  txHash              String?
  hasDiscrepancy      Boolean     @default(false)
  discrepancyNote     String?
  fiatSettled         Boolean     @default(false)
  fiatSettledAt       DateTime?
  disputeReason       String?
  disputedAt          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  collector         User                @relation("CollectorBatches", fields: [collectorId], references: [id])
  destinationCenter User?               @relation("DestinationBatches", fields: [destinationCenterId], references: [id])
  consolidatedBatch ConsolidatedBatch?  @relation(fields: [consolidatedBatchId], references: [id])
  requests          CollectionRequest[]
  disputes          DisputeCase[]

  @@index([collectorId, status])
  @@index([destinationCenterId, status])
  @@index([collectorId, destinationCenterId, status])
  @@index([destinationCenterId])
  @@index([createdAt])
  @@map("batches")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum ConsolidatedStatus {
  PENDING_SALE
  SOLD
}

model ConsolidatedBatch {
  id          String             @id @default(uuid()) @db.Uuid
  centerId    String             @db.Uuid
  totalWeight Decimal            @db.Decimal(14, 3)
  status      ConsolidatedStatus @default(PENDING_SALE)
  createdAt   DateTime           @default(now())

  center  User    @relation("CenterConsolidations", fields: [centerId], references: [id])
  batches Batch[]
  sales   Sale[]

  @@index([centerId])
  @@index([createdAt])
  @@map("consolidated_batches")
}

enum KycStatus {
  PENDING
  OBSERVED
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

model KycApplication {
  id               String    @id @default(uuid()) @db.Uuid
  status           KycStatus @default(PENDING)
  documentType     String?
  documentNumber   String?
  documentUrl      String?
  documentUrlBack  String?
  selfieUrl        String?
  taxIdRuc         String?
  businessName     String?
  transportType    String?
  vehiclePlate     String?
  bankCci          String?
  associationName  String?
  observationNotes String?
  retryCount       Int       @default(0)
  userId           String    @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([createdAt])
  @@map("kyc_applications")
}

model Sale {
  id                  String   @id @default(uuid()) @db.Uuid
  materialType        String
  weightKg            Decimal  @db.Decimal(12, 3)
  totalAmount         Decimal  @db.Decimal(14, 2)
  buyerId             String   @db.Uuid
  centerId            String   @db.Uuid
  consolidatedBatchId String?  @db.Uuid
  createdAt           DateTime @default(now())

  buyer             User               @relation("BuyerSales", fields: [buyerId], references: [id])
  center            User               @relation("CenterSales", fields: [centerId], references: [id])
  consolidatedBatch ConsolidatedBatch? @relation(fields: [consolidatedBatchId], references: [id])

  @@index([centerId])
  @@index([createdAt])
  @@map("sales")
}

enum CertificateStatus {
  ACTIVE
  REVOKED
}

model Certificate {
  id        String            @id @default(uuid()) @db.Uuid
  status    CertificateStatus @default(ACTIVE)
  ipfsHash  String
  esgImpact Json
  buyerId   String            @db.Uuid
  createdAt DateTime          @default(now())

  buyer User @relation(fields: [buyerId], references: [id])

  @@index([buyerId, status])
  @@index([createdAt])
  @@map("certificates")
}

enum MovementType {
  IN
  OUT
}

model InventoryItem {
  id           String   @id @default(uuid()) @db.Uuid
  materialType String
  quantityKg   Decimal  @db.Decimal(14, 3)
  centerId     String   @db.Uuid
  updatedAt    DateTime @updatedAt

  center User @relation(fields: [centerId], references: [id])

  @@unique([centerId, materialType])
  @@map("inventory_items")
}

model InventoryMovement {
  id           String       @id @default(uuid()) @db.Uuid
  type         MovementType
  quantityKg   Decimal      @db.Decimal(14, 3)
  materialType String
  centerId     String       @db.Uuid
  createdAt    DateTime     @default(now())

  center User @relation(fields: [centerId], references: [id])

  @@map("inventory_movements")
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Complaint {
  id                 String          @id @default(uuid()) @db.Uuid
  correlativeNumber  String          @unique
  documentType       String
  documentNumber     String
  fullName           String
  address            String
  phone              String
  email              String
  isMinor            Boolean         @default(false)
  representativeName String?
  representativeDoc  String?
  goodType           String
  goodDescription    String
  amount             Decimal?        @db.Decimal(12, 2)
  claimType          String
  claimDetail        String
  consumerRequest    String
  status             ComplaintStatus @default(OPEN)
  userId             String?         @db.Uuid
  subject            String?
  description        String?
  legalResponseNote  String?
  respondedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([correlativeNumber])
  @@index([email])
  @@index([userId])
  @@map("complaints")
}

model ComplaintCounter {
  id        String   @id @default(uuid()) @db.Uuid
  year      Int
  type      String   @db.VarChar(10)
  lastValue Int      @default(0) @map("last_value")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([year, type])
  @@index([year, type])
  @@map("complaint_counters")
}


enum RedemptionStatus {
  PENDING
  COMPLETED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum SettlementStatus {
  PENDING
  APPROVED_PENDING_PAYMENT
  PAID
  REJECTED
}

model StoreProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  businessName String
  ruc          String
  address      String
  bankAccount  String
  logoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  redemptions RedemptionTransaction[]
  settlements SettlementRequest[]
  products    Product[]

  @@map("store_profiles")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  PAUSED
  ARCHIVED
}

model Product {
  id                 String        @id @default(uuid()) @db.Uuid
  storeId            String        @db.Uuid
  name               String
  description        String?
  tokenPrice         Decimal       @db.Decimal(14, 4)
  fiatReferencePrice Decimal       @db.Decimal(12, 2)
  stock              Int           @default(0)
  imageUrl           String?
  isActive           Boolean       @default(true)
  productStatus      ProductStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  store StoreProfile @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("products")
}

model RedemptionTransaction {
  id          String           @id @default(uuid()) @db.Uuid
  storeId     String           @db.Uuid
  userId      String?          @db.Uuid
  tokenAmount Decimal          @db.Decimal(14, 4)
  qrCodeRef   String           @unique
  status      RedemptionStatus @default(PENDING)
  txHash      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  store StoreProfile @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User?        @relation("HouseholdRedemptions", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([storeId])
  @@map("redemption_transactions")
}

model SettlementRequest {
  id          String           @id @default(uuid()) @db.Uuid
  storeId     String           @db.Uuid
  tokenAmount Decimal          @db.Decimal(14, 4)
  fiatAmount  Decimal          @db.Decimal(12, 2)
  status      SettlementStatus @default(PENDING)
  receiptUrl  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  store StoreProfile @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("settlement_requests")
}

enum B2bTransferStatus {
  REQUESTED
  ACCEPTED
  DELIVERED
}

model B2bTransfer {
  id                 String            @id @default(uuid()) @db.Uuid
  requestedMaterials Json?
  materials          Json
  status             B2bTransferStatus @default(REQUESTED)
  totalAmount        Decimal?          @db.Decimal(12, 2)
  notes              String?
  buyerId            String            @db.Uuid
  centerId           String            @db.Uuid
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  buyer  User @relation("BuyerTransfers", fields: [buyerId], references: [id])
  center User @relation("CenterTransfers", fields: [centerId], references: [id])

  @@index([buyerId])
  @@index([centerId])
  @@index([status])
  @@map("b2b_transfers")
}

model BetaSignup {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  createdAt DateTime @default(now())

  @@map("beta_signups")
}

model ConsentAudit {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  ipAddress         String
  userAgent         String
  termsVersion      String
  privacyVersion    String   @default("1.0.0")
  marketingAccepted Boolean  @default(false)
  documentHash      String
  consentedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentHash])
  @@map("consent_audits")
}

model AcopioPriceList {
  id           String   @id @default(uuid()) @db.Uuid
  centerId     String   @db.Uuid
  materialType String
  pricePerKg   Decimal  @db.Decimal(10, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  center User @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@unique([centerId, materialType])
  @@map("acopio_price_lists")
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  REJECTED_MANUAL
  REJECTED_OUTBID
  WITHDRAWN
  EXPIRED
}

model AcopioBid {
  id                 String    @id @default(uuid()) @db.Uuid
  requestId          String    @db.Uuid
  centerId           String    @db.Uuid
  proposedRates      Json
  totalEstimatedPenn Decimal   @db.Decimal(12, 2)
  totalEstimatedEco  Decimal   @db.Decimal(14, 4)
  status             BidStatus @default(PENDING)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  request CollectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  center  User              @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([centerId])
  @@map("acopio_bids")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CHARGEBACK_DISPUTED
  CHARGEBACK_LOST
}

enum BlockchainStatus {
  PENDING
  MINTED
  FAILED_BLOCKCHAIN
}

model PaymentTransaction {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @db.Uuid
  amountPen         Decimal           @db.Decimal(12, 2)
  tokenAmount       Decimal           @db.Decimal(14, 4)
  purchaseNumber    String            @unique
  transactionToken  String?
  status            PaymentStatus     @default(PENDING)
  cardBrand         String?
  cardPanMasked     String?
  authorizationCode String?
  actionCode        String?
  traceNumber       String?
  commissionPen     Decimal?          @db.Decimal(12, 2)
  igvPen            Decimal?          @db.Decimal(12, 2)
  receiptId         String?
  blockchainStatus  BlockchainStatus? @default(PENDING)
  gatewayResponse   Json?
  txHash            String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([purchaseNumber])
  @@map("payment_transactions")
}

enum PlatformType {
  ANDROID
  IOS
  WEB
}

model DeviceToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  token     String       @unique
  platform  PlatformType @default(ANDROID)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ==============================================================================
// LIBRO MAYOR DE DOBLE PARTIDA (DOUBLE-ENTRY LEDGER) Y TRANSACTIONAL OUTBOX
// ==============================================================================

enum AccountType {
  USER_WALLET
  STORE_ESCROW
  SYSTEM_MINTING_POOL
  SYSTEM_BURNING_POOL
  SYSTEM_ESCROW_HOLD
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum AccountStatus {
  ACTIVE
  FROZEN_SECURITY
  FROZEN_FRAUD_DEBT
  RESTRICTED_WITHDRAWALS
  CLOSED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

model Account {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String?       @db.Uuid
  accountType   AccountType
  status        AccountStatus @default(ACTIVE)
  currency      String        @default("LIVORA")
  cachedBalance Decimal       @default(0.0000000) @db.Decimal(18, 7)
  isFrozen      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@unique([userId, currency])
  @@index([accountType])
  @@map("accounts")
}

model LedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  accountId      String          @db.Uuid
  entryType      LedgerEntryType
  amount         Decimal         @db.Decimal(18, 7)
  runningBalance Decimal         @db.Decimal(18, 7)
  correlationId  String          @db.Uuid
  description    String
  txHash         String?
  createdAt      DateTime        @default(now())

  account        Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt(sort: Desc)])
  @@index([correlationId])
  @@index([txHash])
  @@map("ledger_entries")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String
  aggregateId   String       @db.Uuid
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0)
  errorMessage  String?
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

enum DisputeStatus {
  OPENED
  EVIDENCE_SUBMITTED
  UNDER_REVIEW
  RESOLVED_PENALIZE_CENTER
  RESOLVED_PENALIZE_COLLECTOR
  RESOLVED_NO_PENALTY
  CLOSED
}

model DisputeCase {
  id                 String        @id @default(uuid()) @db.Uuid
  batchId            String        @db.Uuid
  status             DisputeStatus @default(OPENED)
  openedById         String        @db.Uuid
  collectorStatement String?
  collectorPhotos    Json?
  centerStatement    String?
  centerPhotos       Json?
  adminResolution    String?
  penalizedRole      String?
  penalizedUserId    String?       @db.Uuid
  resolvedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  batch              Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  openedBy           User          @relation("UserDisputes", fields: [openedById], references: [id])

  @@index([batchId])
  @@index([status])
  @@map("dispute_cases")
}


