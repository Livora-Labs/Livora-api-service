# ====================================================================
# Livora Production Environment Template (.env.production.example)
# ====================================================================

# Database Configuration (PostgreSQL 16 + PostGIS)
DB_USER=livora
DB_PASSWORD=livora_super_secret_production_pass
DB_NAME=livora_db
DATABASE_URL="postgresql://livora:livora_super_secret_production_pass@livora_postgres:5432/livora_db?schema=public&pgbouncer=true&connection_limit=10"
POSTGRES_VOLUME_NAME=livora_postgres_data

# Redis Configuration
REDIS_HOST=livora_redis
REDIS_PORT=6379

# Domain & Server Configuration (AWS Lightsail)
DOMAIN=52.200.2.107.sslip.io
SERVER_IP=52.200.2.107

# Server Runtime Configuration
PORT=3000
NODE_ENV=production
APP_MODE=API
DB_POOL_MAX=10
ALLOWED_ORIGINS="https://52.200.2.107.sslip.io"

# Supabase Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Web3 Security Configuration (32-byte hex key)
WALLET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Stellar / Soroban Blockchain Configuration
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
ECOTOKEN_CONTRACT_ID="CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4"
WORKER_SECRET_KEY="SAGXFNNNDT6VNRDIEZ3Z5RXYYPX6ZGXSTNCFNVEY6MOZJURQBUR7ERAZ"

# IPFS Pinata Configuration
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
IPFS_GATEWAY_URL="https://gateway.pinata.cloud/ipfs/"

# Transactional Email (Brevo) - Indecopi Complaints & Legal Notifications
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=notificaciones@livora.pe
BREVO_SENDER_NAME=Livora

# Niubiz Webhook Signature Verification
PAYMENT_WEBHOOK_SECRET=your_niubiz_hmac_webhook_secret

# Firebase Admin SDK (Push Notifications)
FIREBASE_PROJECT_ID=livora-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@livora-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC6...\n-----END PRIVATE KEY-----\n"

# Sentry Production Monitoring
SENTRY_DSN_BACKEND=https://examplePublicKey@o0.ingest.sentry.io/0
