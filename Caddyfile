# HTTPS con certificado automático de Let's Encrypt (dominio sslip.io -> IP)
52.200.2.107.sslip.io {
	handle /arquitectura* {
		root * /srv/public
		rewrite * /arquitectura.html
		file_server
	}
	handle {
		reverse_proxy api:3000
	}
}

# Se mantiene el acceso HTTP directo por IP (compatibilidad con el mobile actual)
http://52.200.2.107 {
	reverse_proxy api:3000
}
