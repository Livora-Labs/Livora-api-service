{
	email info@runway7fashion.com
}

(livora_routes) {
	# Favicon y archivos de marca estáticos
	handle /favicon.ico {
		root * /srv/public
		file_server
	}

	# Landing y archivos estáticos públicos
	handle / {
		root * /srv/public
		rewrite * /landing.html
		file_server
	}
	handle /arquitectura* {
		root * /srv/public
		rewrite * /arquitectura.html
		file_server
	}
	handle /app-release.apk {
		root * /srv/public
		header Content-Type application/vnd.android.package-archive
		header Content-Disposition "attachment; filename=livora.apk"
		file_server
	}
	handle /assets/* {
		root * /srv/public
		file_server
	}
	handle /privacidad* {
		root * /srv/public
		rewrite * /privacidad.html
		file_server
	}
	handle /eliminar-cuenta* {
		root * /srv/public
		rewrite * /eliminar-cuenta.html
		file_server
	}
	handle /terminos* {
		root * /srv/public
		rewrite * /terminos.html
		file_server
	}

	# Endpoints de API Admin REST (matchers exactos para no interceptar páginas web Next.js como /admin/users-kyc o /admin/blockchain)
	@api_admin {
		path /admin/users /admin/users/* /admin/kyc-applications /admin/kyc-applications/* /admin/blockchain/health /admin/audit/* /admin/metrics /admin/metrics/* /admin/payments/*
		not path /admin/users-kyc*
		not path /admin/blockchain
	}
	handle @api_admin {
		reverse_proxy livora_api:3000
	}

	# Aplicación Web Frontend (Next.js Standalone)
	handle /login* {
		reverse_proxy frontend:3001
	}
	handle /admin* {
		reverse_proxy frontend:3001
	}
	handle /company* {
		reverse_proxy frontend:3001
	}
	handle /libro-de-reclamaciones* {
		reverse_proxy frontend:3001
	}
	handle /_next/* {
		reverse_proxy frontend:3001
	}
	handle /images/* {
		reverse_proxy frontend:3001
	}
	handle /icon* {
		reverse_proxy frontend:3001
	}
	handle /manifest.json {
		reverse_proxy frontend:3001
	}
	handle /cookies* {
		reverse_proxy frontend:3001
	}
	handle /perfil* {
		reverse_proxy frontend:3001
	}
	handle /centro* {
		reverse_proxy frontend:3001
	}
	handle /verificar-cuenta* {
		reverse_proxy frontend:3001
	}
	handle /recuperar-contrasena* {
		reverse_proxy frontend:3001
	}
	handle /restablecer-contrasena* {
		reverse_proxy frontend:3001
	}
	handle /store* {
		reverse_proxy frontend:3001
	}

	# WebSockets y API Backend (NestJS Fastify)
	handle /socket.io/* {
		reverse_proxy livora_api:3000 {
			lb_policy cookie lb_livora_ws
			header_up Connection {>Connection}
			header_up Upgrade {>Upgrade}
		}
	}
	handle {
		reverse_proxy livora_api:3000
	}
}

# ===== Dominio Oficial de Producción (grupolivoralabs.com) =====
grupolivoralabs.com {
	import livora_routes
}

# Redirección canónica 301 www -> apex
www.grupolivoralabs.com {
	redir https://grupolivoralabs.com{uri} permanent
}

# API Stellar Dedicada (Mobile & Integraciones)
api.grupolivoralabs.com {
	handle /socket.io/* {
		reverse_proxy livora_api:3000 {
			lb_policy cookie lb_livora_ws
			header_up Connection {>Connection}
			header_up Upgrade {>Upgrade}
		}
	}
	handle {
		reverse_proxy livora_api:3000
	}
}

# ===== Fallbacks de compatibilidad (sslip.io) =====
{$DOMAIN:52.200.2.107.sslip.io} {
	import livora_routes
}

# Acceso HTTP directo por IP y local (compatibilidad con apps móviles y emuladores)
http://{$SERVER_IP:52.200.2.107}, http://10.0.2.2, http://localhost, http://127.0.0.1, http://192.168.1.36 {
	import livora_routes
}

# Puerto 3000 para compatibilidad directa con emuladores Android (10.0.2.2:3000) y desarrollo local
http://:3000 {
	import livora_routes
}

# Subdominio legacy de Stellar en sslip.io (mantiene compatibilidad con versiones previas)
stellar.{$DOMAIN:52.200.2.107.sslip.io} {
	handle /socket.io/* {
		reverse_proxy livora_api:3000 {
			header_up Connection {>Connection}
			header_up Upgrade {>Upgrade}
		}
	}
	handle {
		reverse_proxy livora_api:3000
	}
}
