# HTTPS con certificado automático de Let's Encrypt (dominio sslip.io -> IP)
52.200.2.107.sslip.io {
	# Landing para usuarios finales en la raíz del dominio
	handle / {
		root * /srv/public
		rewrite * /landing.html
		file_server
	}
	handle /arquitectura* {
		root * /srv/public
		rewrite * /arquitectura.html
		file_server
	}
	handle /app-release.apk {
		root * /srv/public
		header Content-Type application/vnd.android.package-archive
		header Content-Disposition "attachment; filename=livora.apk"
		file_server
	}
	handle /assets/* {
		root * /srv/public
		file_server
	}
	handle /privacidad* {
		root * /srv/public
		rewrite * /privacidad.html
		file_server
	}
	handle /eliminar-cuenta* {
		root * /srv/public
		rewrite * /eliminar-cuenta.html
		file_server
	}
	handle /terminos* {
		root * /srv/public
		rewrite * /terminos.html
		file_server
	}
	handle {
		reverse_proxy api:3000
	}
}

# Se mantiene el acceso HTTP directo por IP (compatibilidad con el mobile actual)
http://52.200.2.107 {
	reverse_proxy api:3000
}

# ===== Stack Stellar (paralelo, aislado) =====
stellar.52.200.2.107.sslip.io {
	reverse_proxy stellar_api:3000
}
