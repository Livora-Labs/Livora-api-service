# ==============================================================================
# 1. SERVIDOR Y ENTORNO DE EJECUCIÓN
# ==============================================================================
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://app.livora.pe

# ==============================================================================
# 2. PERSISTENCIA Y MOTOR GEOESPACIAL (PostgreSQL 16 + PostGIS)
# ==============================================================================
DB_USER=livora
DB_PASSWORD=livora_secret
DB_NAME=livora_db
DB_PORT=5432
DATABASE_URL="postgresql://livora:livora_secret@localhost:5432/livora_db?schema=public"

# ==============================================================================
# 3. CONCURRENCIA, REDLOCK Y COLAS (Redis 7 + BullMQ)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================================
# 4. SEGURIDAD Y CUSTODIA CRIPTOGRÁFICA (AES-256-GCM / DOPPLER)
# ==============================================================================
# Clave simétrica maestra de 32 bytes (256 bits) para custodia de wallets
ENCRYPTION_MASTER_KEY=your_64_character_hex_encryption_master_key_here
WALLET_ENCRYPTION_KEY=your_64_character_hex_encryption_master_key_here
JWT_SECRET=livora_ephemeral_jwt_secret_90s_ttl

# ==============================================================================
# 5. BLOCKCHAIN STELLAR & SOROBAN RPC (ALTA DISPONIBILIDAD & FAILOVER)
# ==============================================================================
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Endpoint Primario Dedicado (QuickNode)
STELLAR_RPC_URL="https://your-quicknode-instance.stellar-testnet.quiknode.pro/your_api_key/"

# Endpoint Secundario de Respaldo (SDF Horizon / Soroban RPC Fallback para Opossum)
STELLAR_RPC_FALLBACK_URL="https://soroban-testnet.stellar.org"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"

# Contratos Inteligentes Modulares Soroban (Descomposición Institucional)
LIVORA_TOKEN_CONTRACT_ID="CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4"
ECOBATCH_REGISTRY_CONTRACT_ID="CBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBSC4"
MARKETPLACE_ESCROW_CONTRACT_ID="CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCSC4"

# Clave Secreta de la Cuenta Patrocinadora de Gasless (Relayer Fee-Bump Account)
# [INYECCIÓN EXCLUSIVA EN SIGNER ENGINE - PROHIBIDA EN API GATEWAY]
WORKER_SECRET_KEY="SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
RELAY_MIN_BALANCE_XLM=50

# ==============================================================================
# 6. ALMACENAMIENTO DESCENTRALIZADO (IPFS Pinata) & SUPABASE STORAGE
# ==============================================================================
PINATA_API_KEY="tu_pinata_api_key"
PINATA_SECRET_KEY="tu_pinata_secret_key"
PINATA_JWT="tu_pinata_jwt"
IPFS_GATEWAY_URL="https://gateway.pinata.cloud/ipfs/"

# Supabase Auth & Storage Privado (Respaldos y Archivos)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
SUPABASE_JWT_SECRET="your_supabase_jwt_secret"
SUPABASE_STORAGE_BUCKET="livora-uploads"

# ==============================================================================
# 7. MENSAJERÍA TRANSACCIONAL Y LEGAL (BREVO - LIBRO DE RECLAMACIONES INDECOPI)
# ==============================================================================
BREVO_API_KEY="tu_brevo_api_key"
BREVO_SENDER_EMAIL="notificaciones@livora.pe"
BREVO_SENDER_NAME="Livora Notificaciones Legales"
BETA_NOTIFY_TO="legal@livora.pe"

# ==============================================================================
# 8. NOTIFICACIONES PUSH (FIREBASE ADMIN SDK)
# ==============================================================================
FIREBASE_PROJECT_ID="livora-app-prod"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...-----END PRIVATE KEY-----\n"

# ==============================================================================
# 9. OBSERVABILIDAD Y TELEMETRÍA (SENTRY)
# ==============================================================================
